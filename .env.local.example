# =====================================================
# GREEN AURA SOLAR - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values
# =====================================================

# ── MONGODB (FREE at mongodb.com/atlas) ─────────────
# Step 1: Go to https://cloud.mongodb.com
# Step 2: Create free account → New Project → Free Cluster
# Step 3: Database Access → Add User (username + password)
# Step 4: Network Access → Add IP → Allow All (0.0.0.0/0)
# Step 5: Connect → Drivers → Copy the URI below
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/greenaurasolar?retryWrites=true&w=majority

# ── ADMIN LOGIN (You choose these - just make them strong) ──
# This is your admin panel login at yoursite.com/admin
ADMIN_EMAIL=admin@greenaurasolar.com
ADMIN_PASSWORD=GreenAura@2024!

# ── JWT SECRET (Make up any long random password) ───
# This is just a secret key that protects your admin login
# Example: type random keys like "GreenAuraSolar$SecretKey#2024@Bhubaneswar"
JWT_SECRET=GreenAuraSolar$SecretKey#2024@Bhubaneswar$Solar$Energy

# ── GMAIL EMAIL (To receive customer enquiries) ─────
# Step 1: Go to myaccount.google.com
# Step 2: Security → 2-Step Verification → Turn ON
# Step 3: Security → App Passwords → Select Mail → Generate
# Step 4: Copy the 16-digit password (no spaces) below
EMAIL_USER=sgreenaura2023@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
# (replace xxxx xxxx xxxx xxxx with your 16-digit App Password)

# ── WEBSITE URL ─────────────────────────────────────
# During development:
NEXTAUTH_URL=http://localhost:3000
# After deploying to GoDaddy, change to:
# NEXTAUTH_URL=https://www.greenaurasolar.com
